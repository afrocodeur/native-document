{
  "name": "native-document",
  "version": "1.0.200",
  "description": "A reactive JavaScript framework that preserves native DOM simplicity without sacrificing modern features",
  "author": "AfroCodeur <https://github.com/afrocodeur>",
  "license": "MIT",
  "homepage": "https://github.com/afrocodeur/native-document#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/afrocodeur/native-document.git"
  },
  "bugs": {
    "url": "https://github.com/afrocodeur/native-document/issues"
  },
  "keywords": [
    "reactive",
    "framework",
    "dom",
    "vanilla",
    "javascript",
    "observable",
    "no-virtual-dom",
    "ui"
  ],
  "type": "module",
  "main": "index.js",
  "sideEffects": [
    "index.js",
    "elements.js",
    "**/*.css",
    "**/prototypes",
    "**/NdPrototype.js",
    "**/nd-element-extensions.js",
    "**/nd-element.transition.extensions.js",
    "**/attributes-extensions.js",
    "**/bind-class-extensions.js",
    "**/observable.prototypes.js",
    "**/observable.is-to.js"
  ],
  "scripts": {
    "build": "rollup --config rollup.config.js",
    "build:watch": "rollup --config rollup.config.js --watch",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "i18next": "^25.8.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.33.0",
    "eslint-plugin-jsdoc": "^62.5.4",
    "happy-dom": "^20.10.2",
    "magic-string": "^0.30.21",
    "postcss": "^8.5.12",
    "rollup": "^4.53.3",
    "rollup-plugin-postcss": "^4.0.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
