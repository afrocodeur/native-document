{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@src/*": ["src/*"],
      "@root/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@devtools/*": ["src/devtools/*"],
      "@core": ["index"],
      "@elements": ["elements"]
    }
  },
  "exclude": ["node_modules", "dist"]
}